{
  "$schema": "../schema/actions.schema.json",
  "actions": [
    {
      "id": "open",
      "name": "Open",
      "key": "o",
      "reach": 1,
      "on_bump": true,
      "done": "You open the {was}."
    },
    {
      "id": "close",
      "name": "Close",
      "key": "c",
      "reach": 1,
      "shortcut": true,
      "done": "You close the {now}."
    },
    {
      "id": "cut",
      "name": "Cut",
      "key": "x",
      "reach": 2,
      "clear_line": true,
      "tool_from_material": true,
      "done": "You cut through the {was}."
    },
    {
      "id": "repair",
      "name": "Repair",
      "key": "r",
      "reach": 1,
      "clear_of_items": true,
      "done": "You repair the {was}."
    },
    {
      "id": "pick_up",
      "name": "Pick up",
      "key": "g",
      "reach": 1,
      "on_own_tile": true,
      "effect": "pick_up",
      "seconds": 2
    },
    {
      "id": "take_out",
      "name": "Take out",
      "key": "t",
      "reach": 1,
      "effect": "take_out",
      "seconds": 2
    },
    {
      "id": "smash",
      "name": "Smash",
      "key": "s",
      "reach": 1,
      "done": "You smash the {was} to pieces."
    },
    {
      "id": "dismantle",
      "name": "Dismantle",
      "key": "d",
      "reach": 1,
      "done": "You take the {was} apart."
    },
    {
      "id": "pry",
      "name": "Pry open",
      "key": "p",
      "reach": 1,
      "done": "You lever the {was} open."
    }
  ]
}
